# Copy to .env and fill in. Never commit the real .env.
# QDRANT_URL is always required. OPENAI_API_KEY is only required when
# LLM_PROVIDER=openai. This file ships with LLM_PROVIDER=ollama, the local,
# no-API-key, no-billing setup — leave it as-is unless you want to use OpenAI.

# ---- Required ---------------------------------------------------------------

# Qdrant Cloud: https://xxxx.qdrant.io:6333
# Local Docker:  http://localhost:6333
# docker compose: http://qdrant:6333
QDRANT_URL=http://localhost:6333


# ---- LLM provider -------------------------------------------------------------

# "ollama" runs entirely locally, no API key, no billing. "openai" uses the
# OpenAI API and requires OPENAI_API_KEY below.
LLM_PROVIDER=ollama


# ---- Ollama (used when LLM_PROVIDER=ollama) ----------------------------------

# Requires Ollama installed and running locally: https://ollama.com
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. llama3.2 (3B) is the default. For a faster opt-in:
#   ollama pull llama3.2:1b
# 1B is roughly 1.7x faster but less accurate: it misattributes authorship
# more often and declines off-topic questions less reliably. Measured numbers
# are in README.md, in the "Faster but less accurate: llama3.2:1b" section.
# To override for one run without editing this file:
#   PowerShell: $env:OLLAMA_LLM_MODEL='llama3.2:1b'; npm start
#   POSIX sh:   OLLAMA_LLM_MODEL=llama3.2:1b npm start
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Must match the embedding model's output size. nomic-embed-text produces
# 768-dim vectors. Changing this requires re-indexing into a fresh collection.
OLLAMA_EMBEDDING_DIMENSIONS=768
# This machine has no CUDA GPU, so Ollama runs llama3.2 on CPU — measured at
# roughly 10 tok/s generation and ~25 tok/s prompt processing (see
# scripts/tune-threshold.js output or time a raw `POST /api/generate` call to
# check on different hardware). A live evaluate-chat.js run against this
# machine measured two genuine requests landing at 120.4-120.5s — just over a
# 120000 ceiling — for ordinary multi-chunk synthesis questions, not anything
# pathological; prefill time on a topK=5 context plus generation has enough
# natural variance on CPU-only inference to occasionally clear 2 minutes even
# with CHAT_MAX_OUTPUT_TOKENS capping output length. 180000 (3 min) gives that
# variance headroom without masking a real hang. Keep
# frontend/src/services/chatApi.ts's REQUEST_TIMEOUT_MS in sync with this.
OLLAMA_TIMEOUT_MS=180000


# ---- OpenAI (used when LLM_PROVIDER=openai) ------------------------------------

OPENAI_API_KEY=sk-...

CHAT_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small

# Must match the embedding model's output size. Changing this requires
# re-indexing into a fresh collection.
EMBEDDING_DIMENSIONS=1536

OPENAI_TIMEOUT_MS=60000


# ---- Shared model tuning -------------------------------------------------------

# Applies to whichever provider is active.
CHAT_TEMPERATURE=0.2

# Caps generation length so a rambling answer can't run indefinitely. On this
# CPU-only setup, *prompt* processing (prefill), not generation, dominates a
# typical request's latency — a real measured call with a 1682-token prompt
# and a 23-token completion still took ~91s, almost all of it prefill. This
# setting only bounds the tail: scripts/evaluate-chat.js's real answers ran
# 15-174 completion tokens, so 300 leaves comfortable headroom for a normal
# multi-paragraph answer while capping the worst case (a rambling answer that
# ignores the system prompt's "keep it concise" instruction) well under what
# 500 allowed. Lower further only if answers are still getting cut off.
CHAT_MAX_OUTPUT_TOKENS=300


# ---- Qdrant -----------------------------------------------------------------

# Leave blank for a local Qdrant running without auth.
QDRANT_API_KEY=

QDRANT_COLLECTION=founder_book
QDRANT_TIMEOUT_MS=20000


# ---- Retrieval tuning -------------------------------------------------------

# 0.52 was measured with scripts/tune-threshold.js against the real, fully
# re-indexed founder.pdf collection (Ollama's nomic-embed-text): 10 genuinely
# on-topic questions scored a 0.5576 floor, 10 genuinely off-topic questions
# scored a 0.4736 ceiling — a clean gap, no overlap. 0.52 is that gap's
# midpoint, favoring recall slightly (the widened lexical/RRF fallback in
# retrievalService.js is the safety net for on-topic chunks that still land
# just under this). Re-run that script after any re-chunk or model change
# rather than guessing a new number. If you switch to LLM_PROVIDER=openai,
# text-embedding-3-small scores relevant matches higher on average — 0.65
# (this file's own code-level default) tends to fit that model better, but
# should still be re-verified the same way.
#
# TOP_K stays at 5 rather than widening it further for recall: the
# guaranteed-lexical-slot protection in retrievalService.js (an exact keyword
# match can't be diversity-penalized out by MMR) already recovers the cases a
# wider pool was tried for, without paying for the extra prefill time a bigger
# K costs on CPU-only local inference.
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.52

# Maximal Marginal Relevance: trades a little relevance for diversity so the
# model does not receive the same passage several times over.
RETRIEVAL_USE_MMR=true

# 1.0 = pure relevance, 0.0 = pure diversity.
RETRIEVAL_MMR_LAMBDA=0.7

# Candidate pool size = TOP_K * this, capped at 100.
RETRIEVAL_MMR_POOL_MULTIPLIER=4

# When true, also searches on a couple of LLM-generated alternative phrasings
# of the question and fuses those results back in via RRF (queryExpansionService.js
# + retrievalService.js) — helps a paraphrased question ("who wrote this
# book?") find a chunk that ranks well for a different wording of the same
# question ("who is the author?") but not the one actually asked, without
# hand-listing synonyms for any topic. Code default is false (costs one extra
# chat completion per question); on here because local Ollama inference
# already has the spare time budget for it.
RETRIEVAL_USE_QUERY_EXPANSION=true


# ---- Chunking (changing these requires a re-index) --------------------------

CHUNK_SIZE=1000
CHUNK_OVERLAP=200


# ---- Server and limits ------------------------------------------------------

PORT=3000
NODE_ENV=development

# debug | info | warn | error | silent
LOG_LEVEL=info

MAX_QUESTION_LENGTH=1000
MAX_BODY_BYTES=16384

CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=20

INDEX_RATE_WINDOW_MS=3600000
INDEX_RATE_MAX=5
